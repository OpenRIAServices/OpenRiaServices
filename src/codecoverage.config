<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft code coverage settings, used by the dotnet-coverage tool in CI
  ("dotnet-coverage collect --settings src/codecoverage.config ...").
  The content was ported from the Code Coverage data collector configuration of the
  (now removed) test.runsettings which was used when tests were run with VSTest.
  See https://learn.microsoft.com/dotnet/core/additional-tools/dotnet-coverage#settings

  NOTE: Do not add XML comments inside the "configuration" element below,
  dotnet-coverage then silently ends up not collecting any coverage at all.
-->
<configuration>
  <codecoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*OpenRiaServices\..*.dll$</ModulePath>
        <ModulePath>.*OpenRiaServices\..*.exe$</ModulePath>
      </Include>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.DebuggerHiddenAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.DebuggerNonUserCodeAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <CompanyNames>
      <Exclude>
        <CompanyName>.*microsoft.*</CompanyName>
      </Exclude>
    </CompanyNames>
    <PublicKeyTokens>
      <Exclude>
        <PublicKeyToken>^B77A5C561934E089$</PublicKeyToken>
        <PublicKeyToken>^B03F5F7F11D50A3A$</PublicKeyToken>
        <PublicKeyToken>^31BF3856AD364E35$</PublicKeyToken>
        <PublicKeyToken>^89845DCD8080CC91$</PublicKeyToken>
        <PublicKeyToken>^71E9BCE111E9429C$</PublicKeyToken>
        <PublicKeyToken>^8F50407C4E9E73B6$</PublicKeyToken>
        <PublicKeyToken>^E361AF139669C375$</PublicKeyToken>
        <PublicKeyToken>^103cd86017c38181$</PublicKeyToken>
      </Exclude>
    </PublicKeyTokens>
    <UseVerifiableInstrumentation>True</UseVerifiableInstrumentation>
    <AllowLowIntegrityProcesses>True</AllowLowIntegrityProcesses>
    <CollectFromChildProcesses>True</CollectFromChildProcesses>
    <CollectAspDotNet>False</CollectAspDotNet>
  </codecoverage>
</configuration>