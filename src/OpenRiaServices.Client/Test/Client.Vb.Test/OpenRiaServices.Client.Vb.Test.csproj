<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <DefineConstants>$(DefineConstants);VBTests;ASPNETCORE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);DEBUG</DefineConstants>
    <RootNamespace>OpenRiaServices.Client.Test</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>
  
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472'">
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Data.Linq" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Management" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="..\..\..\Test\OpenRiaservices.EndToEnd.AspNetCore.Test\Main.cs" Link="Main.cs" />
    <Compile Include="..\..\..\Test\OpenRiaservices.EndToEnd.AspNetCore.Test\SharedTestSources\Data\DomainContextTestBase.cs" Link="DomainContextTestBase.cs" />
    <Compile Include="..\..\..\Test\OpenRiaservices.EndToEnd.AspNetCore.Test\SharedTestSources\Data\OperationErrorTest.cs" Link="OperationErrorTest.cs" />
    <Compile Include="..\..\..\Test\OpenRiaservices.EndToEnd.AspNetCore.Test\SharedTestSources\Data\QueryTests.cs" Link="QueryTests.cs" />
    <Compile Include="..\..\..\Test\OpenRiaservices.EndToEnd.AspNetCore.Test\SharedTestSources\Data\TestDataContext.cs" Link="TestDataContext.cs" />
    <Compile Include="..\..\..\Test\OpenRiaservices.EndToEnd.AspNetCore.Test\SharedTestSources\Data\TestHelpers.cs" Link="TestHelpers.cs" />
    <Compile Include="..\..\..\Test\OpenRiaservices.EndToEnd.AspNetCore.Test\Usings.cs" Link="Usings.cs" />
    <Compile Include="..\Client.Test\LegacyTestHelpers\UnitTestBaseExtensions.cs" Link="Client.Test\Utilities\UnitTestBaseExtensions.cs" />
    <Compile Include="..\Client.Test\LegacyTestHelpers\OperationAwaiter.cs" Link="Client.Test\OperationAwaiter.cs" />
    <Compile Include="..\Client.Test\LegacyTestHelpers\TestUris.cs" Link="TestUris.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="Properties\AppManifest.xml" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\..\OpenRiaServices.Client.DomainClients.Http\Framework\OpenRiaServices.Client.DomainClients.Http.csproj" />
    <ProjectReference Include="..\..\..\Test\Desktop\OpenRiaServices.Common.Test\OpenRiaServices.Common.Test.csproj" />
    <ProjectReference Include="..\..\Framework\OpenRiaServices.Client.csproj">
      <Aliases>global,SSmDsClient</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\VbDomainClients\VbDomainClients.vbproj" />
    <ProjectReference Include="..\..\..\Test\AspNetCoreWebsite\AspNetCoreWebsite.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>All</PrivateAssets>
      <Private>false</Private>
      <ExcludeAssets>All</ExcludeAssets>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
      <SetTargetFramework>TargetFramework=net8.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

</Project>