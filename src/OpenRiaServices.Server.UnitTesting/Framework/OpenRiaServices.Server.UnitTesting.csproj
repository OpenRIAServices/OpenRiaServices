<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>OpenRiaServices.UnitTesting</PackageId>
    <Title>Open RIA Services Unit Testing</Title>
    <Description>OpenRiaServices.UnitTesting provides a DomainServiceTestHost that can be used to unit test your Domain Services.</Description>
    <PackageTags>WCF RIA Services RIAServices Testing OpenRiaServices</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenRiaServices.Server\Framework\OpenRiaServices.Server.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="..\..\OpenRiaServices.Client\Framework\Polyfills.cs" Link="Polyfills.cs" />
    <Compile Update="Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
